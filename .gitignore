# Temporary files — not in git
.tmp/

# Local inventory database — recreated by tools/inventory.py init
data/inventory.db

# Python cache
__pycache__/
*.pyc

# Per-task project folders (each can be its own git repo)
projects/

# Local settings: copy settings.json.example to settings.json and edit it
settings.json

# Reports and test output (audits, reviews) — not in git
out/
