# Temporary files — not in git
.tmp/

# Local inventory database — recreated by tools/inventory.py init
data/inventory.db

# Python cache
__pycache__/
*.pyc

# Per-task project folders (each can be its own git repo); leading slash: the root folder
# or a root link (projects -> ~/repos), not docs/projects.
# Only the empty folder marker travels with the core; no project ever does.
/projects
!/projects/
/projects/*
!/projects/.gitkeep

# A model lab's pages live in its own folder (paths.kb in settings.json), not here
/kb/

# Local settings: copy settings.json.example to settings.json and edit it
settings.json
# Backups written by tools/autodiscovery.py --save (may hold personal paths)
settings.json.bak-*

# Reports and test output (audits, reviews) — not in git
out/
