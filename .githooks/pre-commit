# Pre-commit hook: refuse commits that contain API keys or tokens.
# Enable once per clone:  git config core.hooksPath .githooks
# The scanner is found next to this hook, so core.hooksPath may point here from another repo.
scan="$(cd "$(dirname "$0")/.." && pwd)/tools/secret_scan.py" || exit 1
for py in python3 python "py -3"; do
    if $py -c "import sys; sys.exit(sys.version_info < (3, 10))" >/dev/null 2>&1; then
        exec $py -I "$scan"
    fi
done
echo "pre-commit: Python 3.10+ not found, secret scan skipped" >&2
exit 0
