erDiagram
    machines ||--o{ tools : "hosts"
    services ||--o{ keys : "owns"
    providers ||--o{ keys : "owns"
    providers ||--o{ models : "provides"
    keys ||--o{ models : "secures"
    
    machines {
        int id PK
        text name
        text os
        text python
        text status
    }
    
    services {
        int id PK
        text name
        text kind
        text account
    }
    
    providers {
        int id PK
        text name
        int free_tier
        text status
    }
    
    keys {
        int id PK
        text path
        int service_id FK
        int provider_id FK
        text kind
        text status
    }
    
    models {
        int id PK
        text alias
        text model_id
        int provider_id FK
        int key_id FK
        text tier
        text status
    }
    
    tools {
        int id PK
        text name
        int machine_id FK
        text status
    }
    
    settings {
        text key PK
        text value
    }
